# Local PC only — copy to `.env` at the repo root and fill in values.
# Never commit `.env` (it is gitignored). BPEAI platform keys are not used locally.
# Public repo: keep this file empty of real secrets.

# Provider: openai (default) | anthropic | google | xai
# CREATOR_LLM_PROVIDER=openai

# Preferred model id (falls back to provider default / OPENAI_* for openai)
# CREATOR_LLM_MODEL=gpt-5.2

# Required for LLM-assisted free-text parsing and for agent self.call_openai_json(...)
# when CREATOR_LLM_PROVIDER=openai (default).
OPENAI_API_KEY=

# Quality bar for equipment_evaluator apps: use a strong reasoning-capable model.
# Code default remains gpt-4o for broad compatibility; for GPT-parity depth set e.g.:
OPENAI_CREATOR_MODEL=gpt-5.2
# OPENAI_MODEL=gpt-5.2

# Output budget for deep engineering reports (evaluator quality uplift)
# Prefer CREATOR_LLM_MAX_OUTPUT_TOKENS; OPENAI_* kept for compatibility.
OPENAI_CREATOR_MAX_OUTPUT_TOKENS=16000
# CREATOR_LLM_MAX_OUTPUT_TOKENS=16000

# --- Optional non-OpenAI providers (v1 allowlist) ---
# CREATOR_LLM_PROVIDER=anthropic
# CREATOR_LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=
# pip install 'bpeai-creator-sdk[anthropic]'

# CREATOR_LLM_PROVIDER=google
# CREATOR_LLM_MODEL=gemini-2.5-pro
# GOOGLE_API_KEY=
# (alias: GEMINI_API_KEY)
# pip install 'bpeai-creator-sdk[google]'

# CREATOR_LLM_PROVIDER=xai
# CREATOR_LLM_MODEL=grok-3
# XAI_API_KEY=

# Optional: override shared PPTX/PDF style templates seeded into creator packs'
# py/knowledge/<pack>/references/ (does not copy website knowledge YAML).
# Default (no env): py/knowledge/_templates/references/ in this repo, then
# ~/bpeai/website/references when present.
# BPEAI_TEMPLATE_REFERENCES_ROOT=

# Optional Serper web search (agent self.serper_search); missing key returns []
SERPER_API_KEY=

# Optional: fetch top search result page excerpts for deeper citations (default on when Serper works)
# BPEAI_FETCH_SEARCH_EXCERPTS=1
# BPEAI_SEARCH_EXCERPT_MAX_CHARS=1200
# BPEAI_SEARCH_EXCERPT_MAX_PAGES=6
